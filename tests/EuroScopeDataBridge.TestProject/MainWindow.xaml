<Window x:Class="EuroScopeDataBridge.TestProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EuroScopeDataBridge Test Client" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Connection Bar -->
        <Border Grid.Row="0" Padding="6" Background="#F0F0F0" CornerRadius="4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Label Content="Host:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" VerticalAlignment="Center" Margin="4,0"/>
                <Label Content="Port:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" VerticalAlignment="Center" Margin="4,0"/>
                <Button Content="Connect" Command="{Binding ConnectCommand}"
                        Width="70" Margin="8,0,4,0"
                        IsEnabled="{Binding IsNotConnected}"/>
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                        Width="70" Margin="4,0"
                        IsEnabled="{Binding IsConnected}"/>
                <Rectangle Width="14" Height="14" RadiusX="7" RadiusY="7" Margin="12,0,4,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="LimeGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Fill" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Margin="6,0,0,0" FontSize="12"/>
                <TextBlock VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12">
                    <Run Text="Msgs:"/>
                    <Run Text="{Binding MessageCount}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Quick Commands -->
        <Border Grid.Row="1" Padding="6" Background="#FAFAFA" CornerRadius="4" Margin="0,0,0,6">
            <WrapPanel>
                <Button Content="Get Flight Plans" Command="{Binding GetFlightPlansCommand}"
                        Margin="2" Width="120"/>
                <Button Content="Get Radar Targets" Command="{Binding GetRadarTargetsCommand}"
                        Margin="2" Width="130"/>
                <Button Content="Get Controllers" Command="{Binding GetControllersCommand}"
                        Margin="2" Width="120"/>
                <Button Content="Clear Log" Command="{Binding ClearLogCommand}"
                        Margin="2" Width="80"/>
            </WrapPanel>
        </Border>

        <!-- Data Tabs -->
        <TabControl Grid.Row="2" Margin="0,0,0,6">
            <TabItem Header="Flight Plans">
                <DataGrid ItemsSource="{Binding FlightPlans}" AutoGenerateColumns="True"
                          IsReadOnly="True" SelectionMode="Single"
                          SelectedItem="{Binding SelectedFlightPlan}"/>
            </TabItem>
            <TabItem Header="Radar Targets">
                <DataGrid ItemsSource="{Binding RadarTargets}" AutoGenerateColumns="True"
                          IsReadOnly="True" SelectionMode="Single"
                          SelectedItem="{Binding SelectedRadarTarget}"/>
            </TabItem>
            <TabItem Header="Controllers">
                <DataGrid ItemsSource="{Binding Controllers}" AutoGenerateColumns="True"
                          IsReadOnly="True" SelectionMode="Single"
                          SelectedItem="{Binding SelectedController}"/>
            </TabItem>
        </TabControl>

        <!-- Log Panel + Custom Command -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Command Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <Button Content="Send" Command="{Binding SendCustomCommand}"
                        DockPanel.Dock="Right" Width="60" Margin="4,0,0,0"/>
                <TextBox Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="12"/>
            </DockPanel>

            <!-- Log -->
            <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                     Background="#1E1E1E" Foreground="#DCDCDC"
                     FontFamily="Consolas" FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
