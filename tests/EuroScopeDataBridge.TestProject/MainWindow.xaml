<Window x:Class="EuroScopeDataBridge.TestProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EuroScopeDataBridge Test Client" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Connection Bar -->
        <Border Grid.Row="0" Padding="6" Background="#F0F0F0" CornerRadius="4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Label Content="Host:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" VerticalAlignment="Center" Margin="4,0"/>
                <Label Content="Port:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" VerticalAlignment="Center" Margin="4,0"/>
                <Button Content="Connect" Command="{Binding ConnectCommand}"
                        Width="70" Margin="8,0,4,0"
                        IsEnabled="{Binding IsNotConnected}"/>
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                        Width="70" Margin="4,0"
                        IsEnabled="{Binding IsConnected}"/>
                <Rectangle Width="14" Height="14" RadiusX="7" RadiusY="7" Margin="12,0,4,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="LimeGreen"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Fill" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Margin="6,0,0,0" FontSize="12"/>
                <TextBlock VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12">
                    <Run Text="Msgs:"/>
                    <Run Text="{Binding MessageCount}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Quick Commands -->
        <Border Grid.Row="1" Padding="6" Background="#FAFAFA" CornerRadius="4" Margin="0,0,0,6">
            <WrapPanel>
                <Button Content="Get Flight Plans" Command="{Binding GetFlightPlansCommand}"
                        Margin="2" Width="120"/>
                <Button Content="Get Radar Targets" Command="{Binding GetRadarTargetsCommand}"
                        Margin="2" Width="130"/>
                <Button Content="Get Controllers" Command="{Binding GetControllersCommand}"
                        Margin="2" Width="120"/>
                <Button Content="Clear Log" Command="{Binding ClearLogCommand}"
                        Margin="2" Width="80"/>
            </WrapPanel>
        </Border>

        <!-- Data Tabs -->
        <TabControl Grid.Row="2" Margin="0,0,0,6">
            <TabItem Header="Flight Plans">
                <DataGrid ItemsSource="{Binding FlightPlans}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single"
                          SelectedItem="{Binding SelectedFlightPlan}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Callsign" Binding="{Binding Callsign}"/>
                        <DataGridTextColumn Header="Origin" Binding="{Binding Origin}"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}"/>
                        <DataGridTextColumn Header="Alternate" Binding="{Binding Alternate}"/>
                        <DataGridTextColumn Header="Route" Binding="{Binding Route}"/>
                        <DataGridTextColumn Header="Aircraft Type" Binding="{Binding AircraftType}"/>
                        <DataGridTextColumn Header="Squawk" Binding="{Binding Squawk}"/>
                        <DataGridTextColumn Header="Cleared Alt" Binding="{Binding ClearedAltitude}"/>
                        <DataGridTextColumn Header="Final Alt" Binding="{Binding FinalAltitude}"/>
                        <DataGridTextColumn Header="Scratchpad" Binding="{Binding Scratchpad}"/>
                        <DataGridTextColumn Header="Speed" Binding="{Binding Speed}"/>
                        <DataGridTextColumn Header="Heading" Binding="{Binding Heading}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Radar Targets">
                <DataGrid ItemsSource="{Binding RadarTargets}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single"
                          SelectedItem="{Binding SelectedRadarTarget}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Callsign" Binding="{Binding Callsign}"/>
                        <DataGridTextColumn Header="System ID" Binding="{Binding SystemId}"/>
                        <DataGridTextColumn Header="Vert Speed" Binding="{Binding VerticalSpeed}"/>
                        <DataGridTextColumn Header="Track Hdg" Binding="{Binding TrackHeading}"/>
                        <DataGridTextColumn Header="Ground Speed" Binding="{Binding GroundSpeed}"/>
                        <DataGridTextColumn Header="Correlated" Binding="{Binding CorrelatedCallsign}"/>
                        <DataGridTextColumn Header="Latitude" Binding="{Binding Latitude}"/>
                        <DataGridTextColumn Header="Longitude" Binding="{Binding Longitude}"/>
                        <DataGridTextColumn Header="Flight Level" Binding="{Binding FlightLevel}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Controllers">
                <DataGrid ItemsSource="{Binding Controllers}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single"
                          SelectedItem="{Binding SelectedController}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Callsign" Binding="{Binding Callsign}"/>
                        <DataGridTextColumn Header="Position ID" Binding="{Binding PositionId}"/>
                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                        <DataGridTextColumn Header="Frequency" Binding="{Binding PrimaryFrequency}"/>
                        <DataGridTextColumn Header="Facility" Binding="{Binding Facility}"/>
                        <DataGridTextColumn Header="Rating" Binding="{Binding Rating}"/>
                        <DataGridTextColumn Header="Is Controller" Binding="{Binding IsController}"/>
                        <DataGridTextColumn Header="Range" Binding="{Binding Range}"/>
                        <DataGridTextColumn Header="Sector File" Binding="{Binding SectorFile}"/>
                        <DataGridTextColumn Header="Is Breaking" Binding="{Binding IsBreaking}"/>
                        <DataGridTextColumn Header="Ongoing Able" Binding="{Binding IsOngoingAble}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Log Panel + Custom Command -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Command Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <Button Content="Send" Command="{Binding SendCustomCommand}"
                        DockPanel.Dock="Right" Width="60" Margin="4,0,0,0"/>
                <TextBox Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="12"/>
            </DockPanel>

            <!-- Log -->
            <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                     Background="#1E1E1E" Foreground="#DCDCDC"
                     FontFamily="Consolas" FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
